/target
**/*.rs.bk
*.pdb

# The local history is a regenerable index; it is never committed.
*.db
*.db-journal

# Per-environment secrets: the .http ecosystem's convention is that the
# private file stays out of git. Only `http-client.env.json` is committed.
http-client.private.env.json
# The example workspace's is the exception: its token is fake, and the
# integration tests need it to pass in CI.
!examples/demo/http-client.private.env.json

# The helptags are generated by the plugin manager on install; they are
# derived from `doc/http-studio.txt`.
/doc/tags

# Secrets held in environment variables.
.env
.env.*
!.env.example
