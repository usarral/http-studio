# Copy this to `.env` (git-ignored), or export the variables in your shell.
#
# Every `HTS_SECRET_<NAME>` variable becomes available in the `.http` files as
# `{{<name>}}`, lowercased, taking priority over environments and collections.
#
# This is the route meant for CI. Locally, `http-client.private.env.json` is
# usually more convenient, and it also allows one value per environment.
HTS_SECRET_API_TOKEN=put-your-token-here
